# Standard .gitignore for .NET
[Bb]in/
[Oo]bj/
[Oo]ut/
.vs/
.vscode/
*.user
*.userosscache
*.sln.docuser
.consul/
.config/

# Visual Studio files
.vs/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa]rm/
[Aa]rm64/
bld/
[Bb]in/
[Oo]bj/

# Logs and databases
*.log
*.txt
*.sqlite
*.db

# Temporary files
*.tmp
*.temp
.DS_Store

# Static web assets
wwwroot/lib/
wwwroot/uploads/*
!wwwroot/uploads/.gitkeep

# Exclude large logs/backups specifically in this project
build_errors.txt
build_output.txt
migration_log.txt
*crdownload
