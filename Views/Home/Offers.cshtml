@{
    ViewData["Title"] = "Offres d'emploi - ECS Informatique";
}

<!-- Page Header with Background Image -->
<section id="careers-banner" class="careers-banner d-flex align-items-center justify-content-center text-center text-white" 
         style="background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url('/Carrière/photoequipe.jpg') no-repeat center center; background-size: cover; height: 350px;">
    <div class="container animate__animated animate__fadeIn">
        <h1 class="display-3 fw-bold mb-3">Carrière</h1>
        <p class="lead mb-4">Rejoignez-nous ! Envoyez-nous votre candidature ou vos questions sur nos offres. Notre service RH vous recontactera.</p>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb justify-content-center">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-success text-decoration-none">Home</a></li>
                <li class="breadcrumb-item"><a href="#" class="text-white text-decoration-none">Carrière</a></li>
                <li class="breadcrumb-item active text-white" aria-current="page">Offres d'emploi</li>
            </ol>
        </nav>
    </div>
</section>

<!-- Offers Selection Section -->
<section id="offers-list" class="py-5 bg-white">
    <div class="container">
        <div class="section-title mb-5">
            <h2 class="fw-bold text-dark h3">Offres d'emploi disponibles</h2>
        </div>

        <div class="alert alert-success border-0 rounded-3 p-4" style="background-color: #d1e7dd; color: #0f5132;">
            <p class="mb-0">Aucune offre d'emploi disponible pour le moment. Veuillez vérifier ultérieurement.</p>
        </div>
    </div>
</section>

<style>
    .careers-banner {
        width: 100%;
        position: relative;
    }
    
    .careers-banner .breadcrumb-item + .breadcrumb-item::before {
        color: #fff;
        content: "/";
    }

    .careers-banner a:hover {
        color: #28a745 !important;
    }

    .section-title h2 {
        position: relative;
        padding-bottom: 10px;
    }

    /* Animation for the banner text */
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate__fadeIn {
        animation: fadeIn 1s ease-out;
    }
</style>
