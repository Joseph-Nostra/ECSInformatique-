<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ECS Informatique</title>
    <link rel="icon" type="image/png" href="~/Carrière/logo2.png" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SiteRCSInformatique.styles.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-element-bundle.min.js"></script>
</head>

<body class="d-flex flex-column min-vh-100">
    <div id="preloader"></div>

    <header class="header sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom box-shadow">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="/Carrière/logo2.png" alt="Logo" style="height: 50px;" class="me-2" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto align-items-center">
                        <li class="nav-item">
                            <a class="nav-link custom-link" asp-controller="Home" asp-action="Index">ACCUEIL</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link custom-link" href="#about">À PROPOS</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link custom-link" href="#services">SERVICES</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link custom-link" href="/#references">RÉFÉRENCES</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link custom-link" href="/#partners">PARTENAIRES</a>
                        </li>
                        <li class="nav-item dropdown custom-dropdown">
                            <a class="nav-link custom-link dropdown-toggle" href="#" role="button"
                                data-bs-toggle="dropdown" aria-expanded="false">
                                CARRIÈRE
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark border-0 shadow-sm">
                                <li><a class="dropdown-item custom-link" asp-controller="Home" asp-action="Offers">Nos
                                        Offres</a></li>
                                <li><a class="dropdown-item custom-link" asp-controller="Home"
                                        asp-action="Candidature">Candidature spontanée</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link custom-link" href="#contact">CONTACT</a>
                        </li>
                        <li class="nav-item ms-lg-3">
                            <button id="theme-toggle" class="theme-toggle border-0 bg-transparent">
                                <i class="bi bi-moon-stars"></i>
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="content-wrapper">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer id="footer" class="footer dark-background">
        <div class="container footer-top py-5">
            <div class="row gy-4">
                <div class="col-lg-4 col-md-6 footer-about">
                    <a href="/" class="logo d-flex align-items-center mb-3">
                        <span class="sitename">ECS Informatique</span>
                    </a>
                    <div class="footer-contact pt-2">
                        <p class="mb-1"><strong>Siège Rabat</strong></p>
                        <p class="mb-3">54 Avenue Mehdi Ben Barka - Rabat, Maroc</p>
                        <p class="mb-1"><strong>Téléphone:</strong> <span>+212(0) 530-300600</span></p>
                        <p class="mb-0"><strong>Email:</strong> <span>ecs@ecs.net.ma</span></p>
                    </div>
                    <div class="social-links d-flex mt-4 gap-3">
                        <a href="#" class="social-link"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" class="social-link"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="social-link"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="social-link"><i class="bi bi-linkedin"></i></a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-3 footer-links">
                    <h4 class="mb-3">Liens utiles</h4>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a href="/#hero" class="footer-link">Accueil</a></li>
                        <li class="mb-2"><a href="/#about" class="footer-link">À propos</a></li>
                        <li class="mb-2"><a href="/#services" class="footer-link">Services</a></li>
                        <li class="mb-2"><a href="/#references" class="footer-link">RÉFÉRENCES</a></li>
                        <li class="mb-2"><a href="/#contact" class="footer-link">Contact</a></li>
                    </ul>
                </div>

                <div class="col-lg-2 col-md-3 footer-links">
                    <h4 class="mb-3">Nos Services</h4>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a href="/#services" class="footer-link">Développement d'applications</a></li>
                        <li class="mb-2"><a href="/#services" class="footer-link">Sécurité des systèmes</a></li>
                        <li class="mb-2"><a href="/#services" class="footer-link">Infrastructure</a></li>
                        <li class="mb-2"><a href="/#services" class="footer-link">Business Intelligence</a></li>
                        <li class="mb-2"><a href="/#services" class="footer-link">Cloud</a></li>
                        <li class="mb-2"><a href="/#services" class="footer-link">ERP Education</a></li>
                    </ul>
                </div>

                <div class="col-lg-4 col-md-12 footer-newsletter">
                    <h4 class="mb-3">Notre Newsletter</h4>
                    <p class="mb-4">Abonnez-vous à notre newsletter et recevez les dernières actualités sur nos produits
                        et services !</p>
                    <form id="newsForm" method="post" class="newsletter-form-custom d-flex" asp-controller="Home" asp-action="SubscribeNewsletter">
                        @Html.AntiForgeryToken()
                        <input type="email" name="email" class="form-control rounded-0 rounded-start border-0 py-3"
                            placeholder="Votre email" required>
                        <input id="btn-news" type="submit" value="Abonnez-vous"
                            class="btn btn-success rounded-0 rounded-end px-4">
                    </form>
                    <div id="newsletter-response" class="mt-2">
                        <div class="error-message3 d-none alert alert-danger py-2 mt-2">Erreur lors de l'abonnement.
                        </div>
                        <div class="sent-message3 d-none alert alert-success py-2 mt-2">Ton abonnement est bien reçu.
                            Merci!</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="container copyright text-center border-top py-4">
            <p class="mb-0">© <span>1988-2025</span> <strong class="px-1 sitename">ECS Informatique</strong></p>
        </div>
    </footer>
    <a href="#" class="back-to-top d-flex align-items-center justify-content-center"><i
            class="bi bi-arrow-up-short"></i></a>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-element-bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
